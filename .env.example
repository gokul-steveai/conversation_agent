# Groq LLM API Key & Model Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily Web Search API Key
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# JWT Authentication Secret Key
JWT_SECRET_KEY=your_production_jwt_secret_key_change_me

# Database Configuration (Async PostgreSQL Primary with Async SQLite Fallback)
DATABASE_URL=sqlite+aiosqlite:///data/conversations.db

# Frontend API Base URL (points to backend server)
BASE_API_URL=http://localhost:8000/api/v1

# Environment (development | production)
ENVIRONMENT=development

# CORS Allowed Origins (comma-separated, required for non-development environments)
ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# LangSmith Tracing & Observability (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT="AI Agents"

# Langfuse Self-Hosted Tracing & Observability
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000

# HuggingFace API Token (Optional, for higher rate limits and faster model downloads)
HF_TOKEN=hf_your_huggingface_token_here